<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <AssemblyName>GlyphAura.Demo</AssemblyName>
    <Description>ASCII-art, PNG and SVG rendering demos for GlyphAura</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="SvgDemo.fs" />
    <Compile Include="PngDemo.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GlyphAura\GlyphAura.fsproj" />
  </ItemGroup>

</Project>
